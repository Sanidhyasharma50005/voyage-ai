# =============================================================================
# VOYAGE PRO — ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# Copy this file to .env.local and populate with your own project credentials.

# -----------------------------------------------------------------------------
# 1. Base Site URL (For OAuth redirects & Webhook origin detection)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 2. Supabase Configuration (Authentication & PostgreSQL Database)
# Obtain from: https://app.supabase.com -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Backend-only Service Role Key (Used exclusively for server order verification & webhooks)
# WARNING: NEVER expose this key on the client or in NEXT_PUBLIC_ variables!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# 3. Razorpay Payment Gateway (Test Mode)
# Obtain from: https://dashboard.razorpay.com -> Settings -> API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay Webhook Secret (Set up in Razorpay Dashboard -> Webhooks -> Add New Webhook)
# Point webhook to: https://your-domain.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# 4. Google Gemini AI Engine (For Custom Itinerary Generation)
# Obtain from: https://aistudio.google.com
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
